{
  "name": "docvault",
  "version": "1.4.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "icons": "python3 scripts/make_icons.py",
    "prebuild": "expo prebuild --platform android --no-install",
    "build:apk": "expo prebuild --platform android --no-install && cd android && ./gradlew assembleRelease",
    "postinstall": "patch-package",
    "test": "npx --yes tsx scripts/test-scan.ts && npx --yes tsx scripts/test-reminders.ts && npx --yes tsx scripts/test-crypto.ts && npx --yes tsx scripts/test-ocr.ts && npx --yes tsx scripts/test-capture.ts && npx --yes tsx scripts/test-favorites.ts && npx --yes tsx scripts/test-naming.ts && npx --yes tsx scripts/test-sort.ts && npx --yes tsx scripts/test-mycard.ts",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^2.4.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-screen-capture": "~8.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-share-intent": "^5.1.1",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-text-extractor": "2.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.24.0",
    "react-native-document-scanner-plugin": "2.0.4",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "react-native-zip-archive": "^7.1.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "description": "Keep family documents and photos organised in folders on your Android phone."
}
