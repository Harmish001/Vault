{
  "expo": {
    "name": "DocVault",
    "slug": "docvault",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "docvault",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.docvault.app",
      "versionCode": 5,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_CONTACTS"
      ]
    },
    "plugins": [
      "expo-contacts",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon-mono.png"
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "*/*"
          ],
          "disableIOS": true
        }
      ],
      "expo-local-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withQuickActions",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FavoriteCard",
              "label": "DocVault favorite",
              "description": "One favorite document. Use the arrows to browse.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "FavoritesCarousel",
              "label": "DocVault favorites",
              "description": "Your favorite documents side by side. Use the arrows to browse.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ]
  }
}
